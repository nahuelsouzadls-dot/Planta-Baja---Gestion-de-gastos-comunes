SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_NAME=propiedad_horizontal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

DJANGO_SETTINGS_MODULE=config.settings.development

MINIO_ROOT_USER=minioadmin-example
MINIO_ROOT_PASSWORD=minioadmin-example-password
MINIO_BUCKET_NAME=comprobantes

# S3 (comprobantes y PDF). En Docker, web ya recibe S3_ENDPOINT_URL=http://minio:9000 y
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000; las credenciales salen de MINIO_ROOT_*.
# En producción (R2): S3_ENDPOINT_URL=S3_PUBLIC_ENDPOINT_URL=https://<cuenta>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=comprobantes
# S3_REGION=auto

